# name. Keep them local -- but the scrubbed, slimmed CI fixture is committed.
*.pwcap
!tests/fixtures/*.pwcap

# Local-only Claude Code permissions (per-developer)
.claude/settings.local.json

# Personal planning / career-strategy docs -- kept local in planning/, not for
# the public repo (they name target companies / career strategy). The whole
# folder is ignored; drop a file elsewhere if you ever want to track it.
planning/
