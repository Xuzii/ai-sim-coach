*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Build / packaging
build/
dist/
*.whl

# Virtual environments
.venv/
venv/

# Local data store (if ever created inside the repo)
*.parquet
pitwall.db

# Raw screen recordings (large) -- the optimized docs/demo.gif is committed instead.
*.mp4

