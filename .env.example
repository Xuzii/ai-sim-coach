# pitwall local secrets -- template, tracked in git.
# Copy to .env (which is gitignored) and fill in your own values.
# pitwall.coach.config.load_dotenv() reads .env at the project root.

# Google Gemini (Phase 2 coach). Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Set this (any non-empty value) to opt in to the live Gemini smoke test
# (tests/test_coach_gemini_live.py). Off by default so CI stays offline.
# PITWALL_LIVE_GEMINI=1
